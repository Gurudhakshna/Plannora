# ==================================================
# PLANNORA — Environment Variables
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file itself.
# ==================================================

# --- Database ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Authentication ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI / LLM ---
OPENAI_API_KEY=

# --- Backend ---
BACKEND_PORT=8000
BACKEND_DEBUG=false
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
