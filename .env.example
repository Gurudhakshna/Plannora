# ==================================================
# PLANNORA — Environment Variables
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file itself.
# ==================================================

# --- Backend ---
# Render supplies DATABASE_URL and generates JWT_SECRET_KEY from render.yaml.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional: needed only for AI-powered API endpoints.
AI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=

# --- Frontend ---
# The current frontend is a standalone local-storage app and does not yet use this.
VITE_API_URL=
