# ==================================================
# Plannora Backend — Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ==================================================

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/plannora

# JWT configuration
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: needed only for AI-powered endpoints.
AI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: override the API base URL (for Azure, LM Studio, Ollama, etc.)
# AI_BASE_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
