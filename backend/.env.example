# ============================================
# Plannora AI Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with actual credentials.

# AI Provider API Key (OpenAI, Azure, etc.)
AI_API_KEY=

# LLM model for chat/generation (e.g. gpt-4o-mini)
LLM_MODEL=

# Embedding model (e.g. text-embedding-3-small)
EMBEDDING_MODEL=

# Optional: override the API base URL (for Azure, LM Studio, Ollama, etc.)
# AI_BASE_URL=

# PostgreSQL connection string (managed by the backend teammate)
DATABASE_URL=
